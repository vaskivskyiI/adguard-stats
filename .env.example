# Copy to .env and edit:  cp .env.example .env && chmod 600 .env

# AdGuard Home web/API address as reachable from inside the container.
# AdGuard on the same host (host network or published port): http://host.containers.internal:3000
ADGUARD_URL=http://192.168.1.1:3000
ADGUARD_USER=admin
ADGUARD_PASSWORD=change-me
# Set to false for self-signed HTTPS certificates.
ADGUARD_VERIFY_TLS=true

# Local time zone: used for day boundaries, heatmaps and timelines.
TZ=Europe/Ljubljana

# Seconds between query-log polls.
POLL_INTERVAL=60
# How long hour-level detail (heatmaps, day timelines, hourly charts) is kept. Daily data is kept forever.
HOURLY_RETENTION_DAYS=400

# Protects the dashboard with HTTP basic auth. Leave the password empty to disable (not recommended).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-too

# Used by scripts/pod.sh only: where the dashboard is published on the host.
HOST_BIND=0.0.0.0
HOST_PORT=8080
